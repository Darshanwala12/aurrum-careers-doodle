# ---- Photoreal live avatar (Anam cara-4) — server-side only, never exposed to browser ----
# 1. Sign up free at https://lab.anam.ai  (no card required for trial)
# 2. Create an API key in the Lab dashboard
# 3. Optionally create a custom "Elena" avatar: upload one photo → ready in <2 min
# 4. Run `npm run avatar-server` to start the token server, then set VITE_AURRUM_LIVE_AVATAR=true
ANAM_API_KEY=

# Optional: custom persona ID from lab.anam.ai (blank = one-shot persona each session)
ANAM_PERSONA_ID=

# Avatar ID (blank = Anam's stock Cara 4 avatar)
# Create your own at https://lab.anam.ai/studio → copy the avatar id from the menu
ANAM_AVATAR_ID=

# Voice ID (blank = default English female voice paired with the avatar)
ANAM_VOICE_ID=

# LLM ID (blank = Anam default; override if your plan has access to GPT-4o etc.)
ANAM_LLM_ID=

# ---- Frontend feature flags ----
# Optional: your own LLM backend for text-mode answers (see src/ai/providers/remoteProvider.js)
VITE_AURRUM_AI_ENDPOINT=

# Optional same-origin TTS endpoint returning audioUrl, visemes and words.
# Without it, browser TTS uses approximate word-boundary mouth timing.
VITE_AURRUM_TTS_ENDPOINT=

# Show the "Talk live with Elena" button (requires avatar-server running + ANAM_API_KEY set)
VITE_AURRUM_LIVE_AVATAR=false
